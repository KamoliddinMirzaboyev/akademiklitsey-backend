# Django
DEBUG=False
SECRET_KEY=your-very-strong-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com

# Database konfiguratsiyasi
# 1-usul: SQLite (tez va oson, local uchun, serverda ham ishlaydi)
USE_SQLITE=True

# 2-usul: DATABASE_URL (Digital Ocean managed DB yoki boshqa PostgreSQL uchun
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 3-usul: PostgreSQL alohida parametrlar
# DB_NAME=academik_litsey
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# CORS — frontend domenini kiriting
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Boshlang'ich administrator (python manage.py seed birinchi marta ishlaganda)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Himoya: login va aloqa formasiga so'rov limitlari
LOGIN_THROTTLE_RATE=10/minute
CONTACT_THROTTLE_RATE=5/hour

# HTTPS reverse proxy sozlamalari (production)
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
